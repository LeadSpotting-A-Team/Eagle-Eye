# --- Project Specific ---
/sandbox/*
!/sandbox/.gitkeep

# --- Security & Config ---
.env
*.pem
*.key

# --- Virtual Environments (recreate on each machine) ---
.venv/
.venv-train/
venv/
env/
ENV/
.python312/

# --- Python Cache ---
__pycache__/
*.py[cod]
.pytest_cache/
.coverage

# --- Build & Distribution ---
dist/
build/
*.egg-info/

# --- IDE & System ---
.vscode/
.idea/
.DS_Store
Thumbs.db

# =============================================================================
# YOLO / Ultralytics — ignore bulk, keep trained model for inference
# =============================================================================

# Pretrained downloads (not needed when using trained best.pt)
yolov8s-obb.pt
yolo26n.pt
yolo11*.pt
yolo12*.pt
yolo26*.pt

# Ultralytics download cache at repo root only (NOT runs/.../weights/)
/weights/

# Training datasets (large — download only if re-training)
/datasets/
datasets/
Datasets/DOTAv1/

# Training run artifacts — keep only best.pt + args.yaml
runs/*
!runs/obb_yolov8s_dota/
runs/obb_yolov8s_dota/*
!runs/obb_yolov8s_dota/weights/
runs/obb_yolov8s_dota/weights/*
!runs/obb_yolov8s_dota/weights/best.pt
!runs/obb_yolov8s_dota/args.yaml

# Weight files: ignore by default, allow Eagle-Eye + trained OBB model
*.pt
!yolov8s.pt
!runs/obb_yolov8s_dota/weights/best.pt
